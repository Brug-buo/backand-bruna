
### ============================================
### TESTES DA API - DIARIO DE TREINOS
### AULAS 04 E 05
### ============================================

@url = http://localhost:3000

### 1 - Listar treinos
GET {{url}}/treinos


### 2 - Buscar treino pelo ID
GET {{url}}/treinos/1


### 3 - Buscar treino inexistente
GET {{url}}/treinos/99999


### 4 - Criar treino sem login (401)
POST {{url}}/treinos
Content-Type: application/json

{
  "nome": "Peito e triceps",
  "duracao": 60
}

### 5 - Login com Diego (200)
POST {{url}}/login
Content-Type: application/json

{
  "usuario": "diego",
  "senha": "1234"
}


### 6 - Perfil do Diego (200)
GET {{url}}/perfil


### 7 - Criar treino logado (200 ou 201)
POST {{url}}/treinos
Content-Type: application/json

{
  "nome": "Peito e triceps",
  "duracao": 60
}


### 8 - Criar outro treino logado
POST {{url}}/treinos
Content-Type: application/json

{
  "nome": "Costas e biceps",
  "duracao": 45
}

### 9 - Login com senha errada (401)
POST {{url}}/login
Content-Type: application/json

{
  "usuario": "diego",
  "senha": "9999"
}


### 10 - Login com usuario inexistente (401)
POST {{url}}/login
Content-Type: application/json

{
  "usuario": "inexistente",
  "senha": "1234"
}


### 11 - Login com Diego (200)
POST {{url}}/login
Content-Type: application/json

{
  "usuario": "diego",
  "senha": "1234"
}


### 12 - Conferir perfil do Diego (200)
GET {{url}}/perfil


### 13 - Login com Aluno (200)
POST {{url}}/login
Content-Type: application/json

{
  "usuario": "aluno",
  "senha": "senha"
}


### 14 - Conferir perfil do Aluno (200)
GET {{url}}/perfil

### 15 - Criar treino logado como Aluno
POST {{url}}/treinos
Content-Type: application/json

{
  "nome": "Corrida",
  "duracao": 30
}


### 16 - Criar treino sem nome
POST {{url}}/treinos
Content-Type: application/json

{
  "duracao": 30
}


### 17 - Criar treino com duracao invalida
POST {{url}}/treinos
Content-Type: application/json

{
  "nome": "Corrida",
  "duracao": -5
}


### 18 - Buscar treino
GET {{url}}/treinos/1


### 19 - Alterar treino
PUT {{url}}/treinos/1
Content-Type: application/json

{
  "nome": "Peito, triceps e ombro",
  "duracao": 75
}


### 20 - Alterar treino inexistente
PUT {{url}}/treinos/99999
Content-Type: application/json

{
  "nome": "Qualquer",
  "duracao": 10
}


### 21 - Apagar treino
DELETE {{url}}/treinos/2


### 22 - Apagar treino inexistente
DELETE {{url}}/treinos/99999


### 23 - Listar treinos novamente
GET {{url}}/treinos


### 24 - Buscar treino por nome
GET {{url}}/treinos?busca=peito


### 25 - Resumo estatistico
GET {{url}}/treinos/resumo


### 26 - ID invalido
GET {{url}}/treinos/abc

### 27 - Logout (204)
POST {{url}}/logout


### 28 - Perfil depois do logout (401)
GET {{url}}/perfil


### 29 - Criar treino depois do logout (401)
POST {{url}}/treinos
Content-Type: application/json

{
  "nome": "Abdominal",
  "duracao": 20
}

